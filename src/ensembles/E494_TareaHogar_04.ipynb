    "id": "VEtp2--t5Ymg"
   },
   "source": [
    "### Scoring"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "hI5008Mj5ZdI"
   },
   "source": [
    "Aplico el modelo final a los datos del futuro"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 33,
   "metadata": {
    "id": "PimBY3N_0ryP"
   },
   "outputs": [],
   "source": [
    "# aplico el modelo a los datos sin clase\n",
    "dfuture <- dataset[foto_mes == 202109]\n",
    "\n",
    "# aplico el modelo a los datos nuevos\n",
    "prediccion <- predict(\n",
    "  modelo_final,\n",
    "  data.matrix(dfuture[, campos_buenos, with= FALSE])\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "D26rNRh55gpw"
   },
   "source": [
    "#### Tabla Prediccion"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "metadata": {
    "id": "RJwg7LHd11yu"
   },
   "outputs": [],
   "source": [
    "# tabla de prediccion\n",
    "\n",
    "tb_prediccion <- dfuture[, list(numero_de_cliente)]\n",
    "tb_prediccion[, prob := prediccion ]\n",
    "\n",
    "# grabo las probabilidad del modelo\n",
    "fwrite(tb_prediccion,\n",
    "  file= \"prediccion.txt\",\n",
    "  sep= \"\\t\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "metadata": {},
   "outputs": [
    {
     "ename": "ERROR",
     "evalue": "Error in parse(text = input): <text>:10:1: unexpected '<'\n9: }\n10: <\n    ^\n",
     "output_type": "error",
     "traceback": [
      "Error in parse(text = input): <text>:10:1: unexpected '<'\n9: }\n10: <\n    ^\nTraceback:\n"
     ]
    }
   ],
   "source": [
    "# Esta función calcula la ganancia para un corte dado\n",
    "fganancia_total <- function(tb_prediccion, ganancia_neta= 117000, costo= 3900) {\n",
    "  # Asegúrate de que la tabla tiene la clase real\n",
    "  tb_prediccion[, ganancia := 0L]\n",
    "  tb_prediccion[clase == \"BAJA+2\", ganancia := ganancia_neta]\n",
    "  \n",
    "  ganancia_total <- sum(tb_prediccion$ganancia) - (nrow(tb_prediccion) * costo)\n",
    "  return(ganancia_total)\n",
    "}\n",
    "<# Asumiendo que dfuture es tu conjunto de validación, que ya tiene la columna 'clase'\n",
    "# Si no la tiene, debes agregarla.\n",
    "# Reemplaza 'dataset' por el nombre de tu dataframe principal si es necesario.\n",
    "dfuture <- dataset[foto_mes == 202109]\n",
    "\n",
    "# Aplica el modelo para obtener las probabilidades\n",
    "prediccion <- predict(\n",
    "  modelo_final,\n",
    "  data.matrix(dfuture[, campos_buenos, with= FALSE])\n",
    ")\n",
    "\n",
    "# Crea la tabla de predicciones con la clase real y las probabilidades\n",
    "tb_prediccion <- dfuture[, list(numero_de_cliente, clase)]\n",
    "tb_prediccion[, prob := prediccion ]\n",
    "\n",
    "# Ordena la tabla de forma descendente por la probabilidad\n",
    "setorder(tb_prediccion, -prob)\n",
    "\n",
    "# Genera un archivo de texto para guardar los resultados\n",
    "resultados_locales <- data.table(\n",
    "  corte = integer(),\n",
    "  ganancia = numeric()\n",
    ")\n",
    "\n",
    "# Ahora, itera por los cortes y calcula la ganancia\n",
    "for (envios in PARAM$kaggle$cortes) {\n",
    "  # Selecciona el subconjunto con las N mejores predicciones\n",
    "  tb_corte <- tb_prediccion[1:envios]\n",
    "  \n",
    "  # Calcula la ganancia para este subconjunto\n",
    "  ganancia_corte <- fganancia_total(tb_corte)\n",
    "\n",
    "  # Agrega el resultado a tu tabla\n",
    "  resultados_locales <- rbind(resultados_locales, list(envios, ganancia_corte))\n",
    "}\n",
    "\n",
    "# Graba los resultados en un archivo de texto\n",
    "fwrite(resultados_locales,\n",
    "       file = \"resultados_locales.txt\",\n",
    "       sep = \"\\t\")\n",
    "\n",
    "# Imprime los resultados en la consola\n",
    "print(resultados_locales)\n"
   ]
  },
